# Copy to .env and fill in. Names follow each SDK's defaults, so clients pick them up automatically.
GEMINI_API_KEY=            # Google AI Studio key (google-genai, pydantic-ai "google-gla:")
ANTHROPIC_API_KEY=         # Claude (pydantic-ai "anthropic:")
OPENAI_API_KEY=            # optional
TYPESAFE_API_KEY=          # Jev / System One models (typesafe_sdk)
PYDANTIC_AI_NO_BANNER=1

# Vertex AI (optional, notebook 02 / pydantic-ai "google-vertex:")
GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
